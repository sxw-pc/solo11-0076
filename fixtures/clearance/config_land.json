{
  "schema_version": "1.0",
  "run_label": "clearance-land-compactness",
  "tolerance": {
    "coordinate_epsilon": 0.000001,
    "near_miss_distance": 2.0,
    "sliver_ratio": 0.1
  },
  "crs": {
    "name": "LOCAL_XY",
    "type": "planar",
    "bounds": {
      "min_x": -100,
      "min_y": -100,
      "max_x": 1000,
      "max_y": 1000
    }
  },
  "layers": [
    {
      "id": "shapes",
      "path": "clearance.geojson",
      "format": "geojson",
      "geometry_types": ["Polygon", "MultiPolygon"],
      "id_field": "feature_id",
      "schema": {
        "feature_id": {"type": "string", "required": true},
        "scenario": {"type": "string", "required": true}
      },
      "clearance_contract": {
        "clearance_width": 0.4,
        "min_core_area": 25.0,
        "usage_contract": "land_compactness"
      }
    }
  ]
}
